# Copy to .env and adjust. Never commit .env - it is gitignored.

# Local development database (docker compose up starts it)
DATABASE_URL=postgresql://root@localhost:26257/hindsight?sslmode=disable

# Reasoning backend (provider-pluggable; deployment wiring is separate).
# Default zero-budget provider for development/demo is gemini.
# Other values may be added as adapters land, e.g. bedrock, azure, deterministic.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
