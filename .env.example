# Copy to .env and adjust. Never commit .env - it is gitignored.

# Local development database (docker compose up starts it)
DATABASE_URL=postgresql://root@localhost:26257/hindsight?sslmode=disable

# Reasoning backend (provider-pluggable; wired up in issue #16).
# One of: bedrock, azure, anthropic. Credentials come from the provider's
# own environment variables or from SSM in deployed environments - never from here.
LLM_PROVIDER=
