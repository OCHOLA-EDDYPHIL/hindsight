# Copy to .env and adjust. Never commit .env - it is gitignored.

# Local development database (docker compose up starts it)
LOCAL_DATABASE_URL=postgresql://root@localhost:26257/hindsight?sslmode=disable
DATABASE_URL=postgresql://root@localhost:26257/hindsight?sslmode=disable

# Gemini is the production and local-development model provider.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_PROVIDER=gemini
HINDSIGHT_GEMINI_REPRESENTATION=raw_control
GEMINI_API_KEY=
# Additional independently quota-limited projects are optional for local runs.
GEMINI_API_KEY_1=

# Optional read-only CloudWatch diagnostics for the local agent CLI. Configure
# all three together; normal AWS credential resolution supplies read access.
# HINDSIGHT_AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1
# HINDSIGHT_STAGE=local

# Lambda uses SSM Parameter Store for secret values. Local runs may still use
# DATABASE_URL and GEMINI_API_KEY values directly; deployed functions should
# set only parameter names.
HINDSIGHT_DATABASE_URL_PARAM=/hindsight/dev/database-url
HINDSIGHT_GEMINI_API_KEYS_PARAM=/hindsight/dev/gemini-api-keys
HINDSIGHT_GEMINI_KEY_HEALTH_TABLE=
HINDSIGHT_FUNCTION_AUTH_TOKEN_PARAM=/hindsight/dev/function-url-token
HINDSIGHT_FUNCTION_AUTH_TOKEN=
HINDSIGHT_DASHBOARD_AUTH_TOKEN=
HINDSIGHT_RUN_QUEUE_URL=
HINDSIGHT_INLINE_WORKER=0
HINDSIGHT_WORKER_MAX_RECEIVES=3
HINDSIGHT_ALLOWED_ORIGINS=
HINDSIGHT_SECURE_COOKIES=1
HINDSIGHT_WEBSOCKET_CONNECTION_TABLE=
HINDSIGHT_WEBSOCKET_MANAGEMENT_ENDPOINT=
HINDSIGHT_CHANGEFEED_WEBHOOK_URL=
HINDSIGHT_CHANGEFEED_AUTH_TOKEN_PARAM=/hindsight/dev/changefeed-token
HINDSIGHT_CHANGEFEED_AUTH_TOKEN=
REASONING_MAX_ATTEMPTS=2

# Optional local OpenTelemetry tracing for demo traces.
HINDSIGHT_OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
